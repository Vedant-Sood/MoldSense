+bool SerialFileStore::userLogFile(const String &path) {
+  if (!path.startsWith("/") || path.indexOf("..") >= 0 || path.indexOf("//") >= 0) return false;
+  return path == "/environment.csv" || path == "/sessions.csv" ||
+         path == "/bme688_iaq_log.csv" || path == "/bme688_full_log.csv" ||
+         (path.startsWith("/cap_") && path.endsWith(".bmerawdata"));
